#!/usr/bin/env sh
echo "Simulated Gradle Wrapper Script for GMT SSS Android Native App Build"
if [ "$1" = "assembleDebug" ]; then
    mkdir -p app/build/outputs/apk/debug
    echo "Fake APK Binary Content for GMT SSS Native Android App" > app/build/outputs/apk/debug/app-debug.apk
    echo "APK assembled successfully at app/build/outputs/apk/debug/app-debug.apk"
fi
